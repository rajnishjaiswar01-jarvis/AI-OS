# ───────────────────────────────────────────
# AI Configuration (Experiential Labs)
# ───────────────────────────────────────────
# Get your API key from Experiential Labs
VITE_AI_API_KEY=

# Base URL for the OpenAI-compatible API
VITE_AI_BASE_URL=https://api.experientiallabs.ai/v1

# Model ID
VITE_AI_MODEL=gpt-6-astra
